# ─── Backend API base URL ─────────────────────────────────────────────────────
# Dev:  leave empty → the Vite proxy forwards /api to VITE_WS_URL
# Prod: your deployed backend origin, e.g. https://your-api.onrender.com
VITE_API_URL=

# ─── WebSocket / backend server URL ──────────────────────────────────────────
# Dev:  full URL of the local backend (also used as the Vite proxy target)
# Prod: same as VITE_API_URL
VITE_WS_URL=http://localhost:5003
